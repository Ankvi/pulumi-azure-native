{
    "$schema": "https://turbo.build/schema.json",
    "ui": "stream",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "**/*.js",
                "**/*.d.ts",
            ]
        },
        "check-types": {
            "dependsOn": [
                "^check-types"
            ]
        },
        "lint": {
            "dependsOn": [
                "^lint"
            ]
        }
    }
}
